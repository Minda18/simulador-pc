# Copia este archivo como .env y cambia los valores antes de ejecutar el proyecto.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Credenciales de PostgreSQL.
POSTGRES_DB=simulador_pc
POSTGRES_USER=simulador
POSTGRES_PASSWORD=cambia-esta-contrasena

# Cadena de conexión usada por Django (host "db" dentro de Docker).
DATABASE_URL=postgres://simulador:cambia-esta-contrasena@db:5432/simulador_pc

# URL del backend para el proxy de Vite.
VITE_API_URL=http://localhost:8000
